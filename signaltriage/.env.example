# Copy this file to .env and fill in your own key. .env is gitignored and must
# never be committed.
#
# Free tier: https://aistudio.google.com/apikey
# Entirely optional -- with no key the app falls back to the deterministic
# template briefing and every other feature works unchanged.
GEMINI_API_KEY=your_key_here

# Optional. Overrides the model used for the briefing. Set this if the default
# returns HTTP 404, which is what a retired model name looks like.
# GEMINI_MODEL=gemini-1.5-flash
